<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Configuration: Strict HTTPS enforcement (Point 19: Force HTTPS) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
